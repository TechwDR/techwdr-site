---
import { siteConfig } from '../config/site';
import { absoluteUrl, url } from '../utils/url';

export interface SEOProps {
  title?: string;
  description?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { title, description = siteConfig.description, noindex = false, schema = [] } = Astro.props;
const fullTitle = title ? `${title}${siteConfig.seo.titleSeparator}${siteConfig.name}` : siteConfig.seo.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = absoluteUrl(siteConfig.seo.ogImage, Astro.site);
const homeUrl = absoluteUrl('/', Astro.site);
const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    name: `${siteConfig.name} / ${siteConfig.brand}`,
    url: homeUrl,
    inLanguage: siteConfig.lang,
    publisher: { '@id': `${homeUrl}#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${homeUrl}#organization`,
    name: siteConfig.brand,
    url: homeUrl,
    logo: absoluteUrl('/icon-512.png', Astro.site),
    founder: { '@id': `${homeUrl}#person` },
  },
];
const jsonLd = [...siteSchema, ...schema];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={`${siteConfig.name} / ${siteConfig.brand}`} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={siteConfig.seo.ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={siteConfig.seo.twitterHandle} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={siteConfig.seo.ogImageAlt} />
<meta name="theme-color" content={siteConfig.seo.themeColor} />
<link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
<link rel="manifest" href={url('/site.webmanifest')} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
